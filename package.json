{
  "name": "wheelbarrow-studios-story-maker",
  "version": "0.4.55",
  "author": "Wheelbarrow Studios",
  "private": true,
  "description": "Wheelbarrow Studios Story Maker — an AI-native visual production studio.",
  "main": "electron-main.js",
  "scripts": {
    "build": "vite build",
    "desktop": "electron .",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:mac": "vite build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "build:mac:universal": "vite build && electron-builder --mac dmg zip --universal --publish never",
    "check": "node --check electron-main.js && vite build",
    "test:visual-direction": "node scripts/visual-direction-smoke.mjs",
    "test:style-propagation": "node scripts/style-propagation-audit.mjs",
    "test:release": "node scripts/ingest-smoke.mjs && node scripts/visual-direction-smoke.mjs && node scripts/style-propagation-audit.mjs && node scripts/release-smoke.mjs && npm run check",
    "test:fal-live": "..\\node_modules\\.bin\\electron.cmd scripts\\fal-multimodal-live-smoke.cjs",
    "test:fal-upscale-live": "..\\node_modules\\.bin\\electron.cmd scripts\\fal-upscale-live-smoke.cjs",
    "test:delivery-pipeline": "node scripts/delivery-pipeline-smoke.mjs",
    "test:local-runtime": "node scripts/local-runtime-smoke.mjs",
    "test:local-image-live": "node scripts/comfy-image-live-smoke.mjs",
    "test:local-video-live": "node scripts/comfy-video-live-smoke.mjs"
  },
  "devDependencies": {
    "electron": "41.7.2",
    "electron-builder": "26.15.3",
    "vite": "8.0.16"
  },
  "build": {
    "electronVersion": "41.7.2",
    "appId": "com.wheelbarrowstudios.storymaker",
    "productName": "Wheelbarrow Studios Story Maker",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "story-ingest.js",
      "assets/**/*",
      "docs/STORYMAKER_GUIDE.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app-icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "icon": "assets/app-icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "backgroundColor": "#0b0e16"
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "storymaker",
        "name": "Storymaker Project",
        "description": "Storymaker Project File",
        "icon": "assets/app-icon.ico",
        "role": "Editor"
      }
    ]
  }
}
