{
  "name": "wheelbarrow-studios-story-maker",
  "version": "0.3.51",
  "author": "Wheelbarrow Studios",
  "private": true,
  "description": "Wheelbarrow Studios Story Maker — an AI-native visual production studio.",
  "main": "electron-main.js",
  "scripts": {
    "build": "..\\wheelbarrow-ai-director\\node_modules\\.bin\\vite.cmd build",
    "desktop": "..\\node_modules\\.bin\\electron.cmd .",
    "build:win": "..\\wheelbarrow-ai-director\\node_modules\\.bin\\vite.cmd build && ..\\node_modules\\.bin\\electron-builder.cmd --win --publish never",
    "build:mac": "vite build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "build:mac:universal": "vite build && electron-builder --mac dmg zip --universal --publish never",
    "check": "node --check electron-main.js && ..\\wheelbarrow-ai-director\\node_modules\\.bin\\vite.cmd build",
    "test:release": "node scripts/ingest-smoke.mjs && node scripts/release-smoke.mjs && npm run check"
    ,"test:fal-live": "..\\node_modules\\.bin\\electron.cmd scripts\\fal-multimodal-live-smoke.cjs"
    ,"test:fal-upscale-live": "..\\node_modules\\.bin\\electron.cmd scripts\\fal-upscale-live-smoke.cjs"
  },
  "build": {
    "electronVersion": "41.7.2",
    "appId": "com.wheelbarrowstudios.storymaker",
    "productName": "Wheelbarrow Studios Story Maker",
    "directories": { "output": "dist-release" },
    "files": ["dist/**/*", "electron-main.js", "preload.js", "story-ingest.js", "assets/**/*"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/app-icon.ico" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.video", "icon": "assets/app-icon.icns", "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "dmg": { "title": "${productName} ${version}", "backgroundColor": "#0b0e16" },
    "nsis": { "createDesktopShortcut": "always", "createStartMenuShortcut": true, "include": "build/installer.nsh" },
    "fileAssociations": [
      { "ext": "storymaker", "name": "Storymaker Project", "description": "Storymaker Project File", "icon": "assets/app-icon.ico", "role": "Editor" }
    ]
  }
}
